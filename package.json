{
  "name": "robot-admin",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "description": "Robot 中后台管理系统团队架构模板 - 基于 Vue3 + Vite 的企业级中后台解决方案",
  "author": {
    "name": "ChenY",
    "email": "ycyplus@gmail.com",
    "url": "https://github.com/ChenyCHENYU"
  },
  "license": "MIT",
  "scripts": {
    "dev": "NODE_NO_WARNINGS=1 env-manager dev && vite",
    "dev:local": "USE_LOCAL_PACKAGES=true bun run dev",
    "dev:components": "USE_LOCAL_COMPONENTS=true bun run dev",
    "dev:devtools": "VITE_DEVTOOLS=true bun run dev",
    "build": "env-manager prod && vite build",
    "build:test": "env-manager test && vite build --mode test --emptyOutDir",
    "build:staging": "env-manager staging && vite build --mode staging --profile",
    "preview": "bun run build && vite preview",
    "type-watch": "vue-tsc --noEmit --watch",
    "type-build": "vue-tsc --build tsconfig/tsconfig.app.json --force",
    "build:check": "bun run type-build && bun run build",
    "test": "bun test",
    "lint:check": "oxlint . -D correctness --ignore-path .gitignore",
    "verify": "bun run lint:check && bun run type-build && bun run test && bun run build",
    "lint": "oxlint . --fix -D correctness --ignore-path .gitignore && eslint . --fix",
    "lint:staged": "lint-staged",
    "commitlint": "commitlint",
    "format": "prettier --write src/",
    "prepare": "husky",
    "commit": "bun run cz",
    "check-branch": "gbd",
    "check-types": "ts-type-cleaner analyze",
    "gen:route-i18n": "bun run scripts/generate-route-translations.ts",
    "deploy": "bash ./scripts/merge-and-deploy.sh",
    "sync-deploy-branch": "bash ./scripts/sync-dev.sh",
    "analyze": "vite build --mode analyze",
    "cz": "git-cz",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "mcp": "bun run mcp/server.ts"
  },
  "dependencies": {
    "@antv/x6": "^3.1.8",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "^5.0.1",
    "@kangc/v-md-editor": "^2.3.18",
    "@robot-admin/directives": "2.0.1",
    "@robot-admin/file-utils": "3.0.1",
    "@robot-admin/form-validate": "3.4.2",
    "@robot-admin/git-standards": "1.0.4",
    "@robot-admin/layout": "2.3.2",
    "@robot-admin/naive-ui-components": "0.11.6",
    "@robot-admin/request-core": "0.2.0",
    "@robot-admin/theme": "0.4.0",
    "@splinetool/runtime": "^2.0.36",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@visactor/vtable-gantt": "^1.26.7",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.20.0",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "motion-v": "^2.4.0",
    "nprogress": "^0.2.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "print-js": "^1.6.0",
    "robot-admin-env-manager": "^1.1.0",
    "rolldown": "1.2.7",
    "vite-plugin-preloader": "^2.0.1",
    "vue": "^3.5.42",
    "vue-command-palette": "^0.2.3",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@iconify-json/carbon": "^1.2.26",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/mdi": "^1.2.3",
    "@inspira-ui/plugins": "^0.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.1",
    "@types/nprogress": "^0.2.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/runtime-core": "^3.5.42",
    "@vue/tsconfig": "^0.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commitizen": "^4.3.2",
    "conventional-changelog-cli": "^5.0.0",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.3.4",
    "eslint-plugin-oxlint": "~1.81.0",
    "eslint-plugin-vue": "^10.10.0",
    "estree-walker": "3.0.3",
    "git-branch-check-diff-commits": "^1.3.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "naive-ui": "^2.45.3",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.81.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass": "^1.104.0",
    "ts-type-cleaner": "^5.1.0",
    "typescript": "~5.8.3",
    "unocss": "^66.10.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.2",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vite-console-plugin": "^2.0.16",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    }
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,vue}": [
      "oxlint --max-warnings 0 --deny-warnings",
      "eslint --fix --no-cache",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
